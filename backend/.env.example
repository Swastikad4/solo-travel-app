# Environment variables for the backend
# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/soloTravelDB

# Server port (leave blank on Render — it sets this automatically)
PORT=5000

# Node environment: "development" or "production"
NODE_ENV=development

# Comma-separated list of allowed frontend origins (leave blank to allow all in dev)
# Example: https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=
