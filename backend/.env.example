# Environment variables for the backend
# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Local: postgresql://user:password@localhost:5432/solo_travel_db
# Cloud (Supabase/Neon/Railway): use your provider's connection string
DATABASE_URL=postgresql://user:password@localhost:5432/solo_travel_db

# Server port (leave blank on Render — it sets this automatically)
PORT=5000

# Node environment: "development" or "production"
NODE_ENV=development

# Comma-separated list of allowed frontend origins (leave blank to allow all in dev)
# Example: https://your-app.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=
